# Service configuration (do not commit)
# Placeholders are filled at image build time by install.sh with random
# values in realistic key formats. Real-looking formats are NOT stored in
# this repository: GitHub push protection rejects them, which is itself a
# sign the lure is convincing.
BILLING_API_URL=https://api.internal-billing/v2
BILLING_API_KEY={{PAYMENTS_SECRET_KEY}}
DATABASE_URL=postgres://app:{{DB_PASSWORD}}@db.internal:5432/app
AWS_ACCESS_KEY_ID={{CLOUD_ACCESS_KEY_ID}}
AWS_SECRET_ACCESS_KEY={{CLOUD_SECRET_KEY}}
